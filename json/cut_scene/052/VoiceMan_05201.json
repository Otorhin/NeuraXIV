{
  "source_file": "exd/cut_scene/052/VoiceMan_05201_0_en.exd",
  "rows": [
    {
      "id": "0x00000000",
      "text": "TEXT_VOICEMAN_05201_000010_RYNE<tab>Назад пути нет... Подготовься!"
    },
    {
      "id": "0x00000001",
      "text": "TEXT_VOICEMAN_05201_000020_GAIA<tab>Итак, это Рамух..."
    },
    {
      "id": "0x00000002",
      "text": "TEXT_VOICEMAN_05201_000030_RYNE<tab>Это сработало! И ветер, и огонь откликнулись на призыв!"
    },
    {
      "id": "0x00000003",
      "text": "TEXT_VOICEMAN_05201_000040_GAIA<tab>Райн! Ты в порядке!?"
    },
    {
      "id": "0x00000004",
      "text": "TEXT_VOICEMAN_05201_000050_RYNE<tab>Так много их... Но с этим мы справимся!"
    },
    {
      "id": "0x00000005",
      "text": "TEXT_VOICEMAN_05201_000060_RYNE<tab>Я вызываю... силу Шивы!"
    },
    {
      "id": "0x00000006",
      "text": "TEXT_VOICEMAN_05201_000070_RYNE<tab>Ааааааа!"
    },
    {
      "id": "0x00000007",
      "text": "TEXT_VOICEMAN_05201_000080_GAIA<tab>Нет! Она потеряла контроль! Ты должен остановить её!"
    }
  ]
}
