    {
      "id": "0x00000018",
      "text": "TEXT_STMBDZ408_02731_TODO_00<tab>Убей кабана."
    },
    {
      "id": "0x00000019",
      "text": "TEXT_STMBDZ408_02731_TODO_01<tab>Поговори с другом Шиндена."
    },
    {
      "id": "0x0000001A",
      "text": "TEXT_STMBDZ408_02731_TODO_02<tab>Сделайте отчет для Шиндана."
