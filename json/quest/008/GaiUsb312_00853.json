      "text": "TEXT_GAIUSB312_00853_TODO_00<tab>Убейте пугилей."
    },
    {
      "id": "0x00000019",
      "text": "TEXT_GAIUSB312_00853_TODO_01<tab>Уберите тушу."
    },
    {
      "id": "0x0000001A",
