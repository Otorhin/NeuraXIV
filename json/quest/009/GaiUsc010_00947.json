    {
      "id": "0x00000018",
      "text": "TEXT_GAIUSC010_00947_TODO_00<tab>Убейте гиппоцерфов."
    },
    {
      "id": "0x00000019",
      "text": "TEXT_GAIUSC010_00947_TODO_01<tab>Доложите Урдилику."
