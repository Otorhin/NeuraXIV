    {
      "id": "0x00000018",
      "text": "TEXT_GAIUSB908_00931_TODO_00<tab>Убрать обломки."
    },
    {
      "id": "0x00000019",
      "text": "TEXT_GAIUSB908_00931_TODO_01<tab>Доложите Шонолле."
    },
