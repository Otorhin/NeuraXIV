    {
      "id": "0x00000018",
      "text": "TEXT_KINGME104_04935_TODO_00<tab>Поговори со Сфеном."
    },
    {
      "id": "0x00000019",
      "text": "TEXT_KINGME104_04935_TODO_01<tab>Поговори снова с Сфеном."
    },
    {
      "id": "0x0000001A",
      "text": "TEXT_KINGME104_04935_TODO_02<tab>Поговорите с Вук Ламатом."
    },
    {
      "id": "0x0000001B",
      "text": "TEXT_KINGME104_04935_TODO_03<tab>Поговори снова с Вук Ламатом."
