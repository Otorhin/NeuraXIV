      "id": "0x00000001",
      "text": "TEXT_CTSMJICONSTRUCTWORKPLACE_00784_SYSTEM_000_000<tab>Что ты будешь делать?"
    },
    {
      "id": "0x00000002",
      "text": "TEXT_CTSMJICONSTRUCTWORKPLACE_00784_Q1_000_001<tab>Постройте сооружение."
    },
    {
      "id": "0x00000003",
      "text": "TEXT_CTSMJICONSTRUCTWORKPLACE_00784_Q1_000_010<tab>Ничего."
    },
    {
      "id": "0x00000004",
      "text": "TEXT_CTSMJICONSTRUCTWORKPLACE_00784_SYSTEM_000_100<tab>Мастерская I."
    },
    {
      "id": "0x00000005",
      "text": "TEXT_CTSMJICONSTRUCTWORKPLACE_00784_SYSTEM_000_101<tab>Мастерская II."
    },
    {
      "id": "0x00000006",
      "text": "TEXT_CTSMJICONSTRUCTWORKPLACE_00784_SYSTEM_000_102<tab>Мастерская III."
    },
    {
