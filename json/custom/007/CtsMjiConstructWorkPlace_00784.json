      "text": "TEXT_CTSMJICONSTRUCTWORKPLACE_00784_SYSTEM_000_103<tab>Мастерская IV."
    },
    {
      "id": "0x00000008",
      "text": "TEXT_CTSMJICONSTRUCTWORKPLACE_00784_SYSTEM_000_104<tab>Мастерская V."
    },
    {
      "id": "0x00000009",
      "text": "TEXT_CTSMJICONSTRUCTWORKPLACE_00784_SYSTEM_000_110<tab>Амбар I."
    },
    {
