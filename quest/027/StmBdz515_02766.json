      "text": "TEXT_STMBDZ515_02766_TODO_01<tab>Спасите брата Нигена."
    },
    {
      "id": "0x0000001A",
      "text": "TEXT_STMBDZ515_02766_TODO_02<tab>Сообщите Нигену."
