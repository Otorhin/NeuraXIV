    {
      "id": "0x00000018",
      "text": "TEXT_GAIUSB807_00916_TODO_00<tab>Исследуйте Стальную стражу."
    },
    {
      "id": "0x00000019",
      "text": "TEXT_GAIUSB807_00916_TODO_01<tab>Передайте альманах Эженноа."
    },
