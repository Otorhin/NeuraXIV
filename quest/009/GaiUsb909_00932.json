    {
      "id": "0x00000018",
      "text": "TEXT_GAIUSB909_00932_TODO_00<tab>Добудьте жир из шиншилл."
    },
    {
      "id": "0x00000019",
      "text": "TEXT_GAIUSB909_00932_TODO_01<tab>Доставьте жир шиншиллы Шонолле."
    },
