    {
      "id": "0x00000018",
      "text": "TEXT_LUCKMD102_03607_TODO_00<tab>Окажите помощь раненым."
    },
    {
      "id": "0x00000019",
      "text": "TEXT_LUCKMD102_03607_TODO_01<tab>Поговорите с Линой."
    },
