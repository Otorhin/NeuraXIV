      "id": "0x00000018",
      "text": "TEXT_LUCKMD115_03620_TODO_00<tab>Осмотрите указанное место."
    },
    {
      "id": "0x00000019",
      "text": "TEXT_LUCKMD115_03620_TODO_01<tab>Найдите Минфилию."
    },
    {
      "id": "0x0000001A",
      "text": "TEXT_LUCKMD115_03620_TODO_02<tab>Найти Танкреда."
