    {
      "id": "0x00000018",
      "text": "TEXT_GAIUSB011_00818_TODO_00<tab>Соберите оброненные доски."
    },
    {
      "id": "0x00000019",
      "text": "TEXT_GAIUSB011_00818_TODO_01<tab>Верните пиломатериалы Флорану."
