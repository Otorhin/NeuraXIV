      "id": "0x00000018",
      "text": "TEXT_LUCKMB118_03319_TODO_00<tab>Найдите медальон Сэто."
    },
    {
      "id": "0x00000019",
      "text": "TEXT_LUCKMB118_03319_TODO_01<tab>Передайте медальон Сето."
