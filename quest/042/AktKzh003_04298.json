    {
      "id": "0x00000018",
      "text": "TEXT_AKTKZH003_04298_TODO_00<tab>Поговорите с наблюдателем Талассаи."
    },
    {
      "id": "0x00000019",
      "text": "TEXT_AKTKZH003_04298_TODO_01<tab>Покормите Зефирос 72s."
    },
    {
      "id": "0x0000001A",
      "text": "TEXT_AKTKZH003_04298_TODO_02<tab>Доставьте Zephyros 72s наблюдателю Талассаи."
    },
