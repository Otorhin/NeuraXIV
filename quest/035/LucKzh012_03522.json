    {
      "id": "0x00000018",
      "text": "TEXT_LUCKZH012_03522_TODO_00<tab>Ищите детей."
    },
    {
      "id": "0x00000019",
      "text": "TEXT_LUCKZH012_03522_TODO_01<tab>Поговори со Сристяллой."
